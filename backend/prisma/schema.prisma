generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id             Int      @id @default(autoincrement())
  nombre         String   @unique
  password       String   @default("PuertoPerico")
  rol            String   @default("user") // "superadmin" para Jorge
  puntos         Int      @default(0)
  aciertos       Int      @default(0)
  avatarColor    String   @default("blue")
  fecha_creacion DateTime @default(now())
  jugadas        Jugada[]
  notificaciones Notificacion[]
  pagos          PagoUsuario[]
}

model Bote {
  id          Int              @id @default(autoincrement())
  acumulado   Float            @default(0.0)
  actualizado DateTime         @updatedAt
  movimientos MovimientoBote[]
}

model MovimientoBote {
  id        Int      @id @default(autoincrement())
  cantidad  Float
  concepto  String
  jornada   Int?     @default(1)
  aciertos  String?
  autor     String   @default("Jorge")
  fecha     DateTime @default(now())
  boteId    Int?
  bote      Bote?    @relation(fields: [boteId], references: [id])
}

model Jornada {
  id           Int      @id @default(autoincrement())
  numero       Int      @default(1)
  activa       Boolean  @default(true)
  partidos     String?  // JSON con los 6 partidos oficiales de la jornada
  imagenBoleto String?  // Foto del boleto subida por Jorge
  resultados   String?  // JSON con resultados oficiales
  apuestasAceptadas Boolean @default(false)
  fecha        DateTime @default(now())
  jugadas      Jugada[]
}

model Jugada {
  id              Int      @id @default(autoincrement())
  usuarioId       Int?
  usuario         Usuario? @relation(fields: [usuarioId], references: [id])
  jornadaId       Int?
  jornada         Jornada? @relation(fields: [jornadaId], references: [id])
  pronosticos     String?  // JSON de la jugada Quinigol
  numeros         String?  // Compatibilidad
  puntosObtenidos Int      @default(0)
  fecha_creacion  DateTime @default(now())
}

model Notificacion {
  id             Int      @id @default(autoincrement())
  tipo           String   @default("apuesta") // "apuesta"
  usuarioId      Int?
  usuario        Usuario? @relation(fields: [usuarioId], references: [id])
  usuarioNombre  String
  jornadaNumero  Int      @default(7)
  pronosticos    String   // JSON con los pronósticos
  resumen        String?  // Texto de resumen
  leida          Boolean  @default(false)
  fecha_creacion DateTime @default(now())
}

model PagoMes {
  id             Int           @id @default(autoincrement())
  mes            String        @unique // Ej: "Pago Octubre 2026"
  cuota          Float         @default(10.0)
  activo         Boolean       @default(true)
  fecha_creacion DateTime      @default(now())
  pagosUsuarios  PagoUsuario[]
}

model PagoUsuario {
  id             Int       @id @default(autoincrement())
  pagoMesId      Int
  pagoMes        PagoMes   @relation(fields: [pagoMesId], references: [id], onDelete: Cascade)
  usuarioId      Int
  usuario        Usuario   @relation(fields: [usuarioId], references: [id])
  pagado         Boolean   @default(false)
  fechaPago      DateTime?

  @@unique([pagoMesId, usuarioId])
}
